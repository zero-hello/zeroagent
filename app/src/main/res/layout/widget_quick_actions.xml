<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical"
    android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" android:background="@drawable/widget_panel">
    <LinearLayout android:id="@+id/widget_new_chat" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/zero_v6_widget_logo"
            android:importantForAccessibility="no" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1"
            android:ellipsize="end" android:text="@string/zero_v6_widget_prompt" android:textColor="@color/zero_v6_ink"
            android:textSize="14sp" />
    </LinearLayout>
    <ImageView android:id="@+id/widget_voice" android:layout_width="48dp" android:layout_height="match_parent"
        android:scaleType="centerInside" android:contentDescription="@string/shortcut_voice_question"
        android:src="@drawable/zero_v6_widget_voice" />
</LinearLayout>
