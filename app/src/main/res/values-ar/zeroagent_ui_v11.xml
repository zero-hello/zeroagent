<?xml version="1.0" encoding="utf-8"?>
<resources>
  <string name="getting_started_title">بدء الاستخدام</string>
  <string name="getting_started_intro_title">قبل أول محادثة</string>
  <string name="getting_started_intro_desc">يأتي التطبيق بدون أي إعداد: لا يوجد نموذج، والأدوات متوقفة، ولا توجد أذونات. أكمل الخطوات الأربع التالية ليصبح الوكيل الذي ثبّت التطبيق من أجله.</string>
  <string name="getting_started_progress">اكتمل %1$d من %2$d</string>
  <string name="getting_started_step_model_title">إضافة نموذج</string>
  <string name="getting_started_step_model_desc">افتح «المزوّدون» والصق مفتاح API (OpenRouter أو أي نقطة نهاية متوافقة مع OpenAI). بدون نموذج لا تستطيع المحادثة الرد.</string>
  <string name="getting_started_step_tools_title">تشغيل الأدوات</string>
  <string name="getting_started_step_tools_desc">جميع الأدوات متوقفة افتراضيًا، لذا يتصرف التطبيق كتطبيق محادثة عادي. اختر المجموعات التي تريد أن يستخدمها المساعد.</string>
  <string name="getting_started_step_permissions_title">منح الأذونات</string>
  <string name="getting_started_step_permissions_desc">تتيح إمكانية الوصول للوكيل رؤية الشاشة والنقر عليها، ويتيح الوصول إلى الإشعارات قراءة الإشعارات. يمكن تأجيل بقية الأذونات حتى تحتاجها إحدى الأدوات.</string>
  <string name="getting_started_step_workspace_title">ربط مساحة عمل</string>
  <string name="getting_started_step_workspace_desc">تمنح مساحة العمل الوكيل مكانًا للملفات والذاكرة الباردة. اختيارية، لكنها مطلوبة لكل ما يتعلق بالملفات.</string>
  <string name="getting_started_go">فتح</string>
  <string name="getting_started_done">تم</string>
  <string name="getting_started_finish">ابدأ الاستخدام</string>
  <string name="getting_started_later">لاحقًا</string>
  <string name="getting_started_keepalive_title">لا تدع النظام يوقف الخدمة</string>
  <string name="getting_started_keepalive_desc">في بعض الأنظمة (Vivo/Xiaomi/Huawei) تؤدي عملية تنظيف الخلفية إلى إيقاف خدمة إمكانية الوصول بعد فترة من تمكينها، فتتوقف أدوات الشاشة عن العمل. نفّذ خطوات الاستمرار في الخلفية مرة واحدة من إعدادات إمكانية الوصول.</string>
  <string name="getting_started_keepalive_open">فتح</string>
  <string name="perm_label_overlay">العرض فوق التطبيقات الأخرى</string>
  <string name="perm_desc_overlay">يتيح لـ ZeroAgent عرض تراكب «الوكيل يعمل» أثناء تنفيذ الأتمتة.</string>
  <string name="perm_label_write_settings">تعديل إعدادات النظام</string>
  <string name="perm_desc_write_settings">يتيح للوكيل تغيير السطوع عبر set_brightness.</string>
  <string name="perm_label_dnd">الوصول إلى وضع عدم الإزعاج</string>
  <string name="perm_desc_dnd">يتيح للوكيل تغيير وضع الرنين ومستوى صوت كل مسار.</string>
  <string name="perm_label_battery">تجاهل تحسينات البطارية</string>
  <string name="perm_desc_battery">يساعد على استمرار المهام في الخلفية عندما تكون الشاشة مغلقة.</string>
  <string name="perm_label_post_notifications">إرسال الإشعارات</string>
  <string name="perm_desc_post_notifications">يعرض إشعارات الصوت وتقدم المهام والخدمة في الخلفية.</string>
  <string name="perm_desc_custom">إذن مخصص. قد لا يكون التطبيق المالك مثبتًا بعد.</string>
  <string name="perm_desc_auto">يُمنح تلقائيًا عند التثبيت (بدون أي إجراء من المستخدم).</string>
  <string name="perm_label_accessibility">أتمتة الشاشة (إمكانية الوصول)</string>
  <string name="perm_desc_accessibility">مطلوب لأدوات tap وswipe وclick_node وscreenshot وread_window_tree وset_text وغيرها من أدوات التحكم بالواجهة.</string>
  <string name="perm_label_notification_listener">الوصول إلى الإشعارات</string>
  <string name="perm_desc_notification_listener">يسمح للوكيل بقراءة إشعارات التطبيقات التي توافق عليها.</string>
  <string name="perm_label_camera">الكاميرا</string>
  <string name="perm_desc_camera">تستخدمه أداة take_photo لالتقاط صورة ثابتة.</string>
  <string name="perm_label_microphone">الميكروفون</string>
  <string name="perm_desc_microphone">تستخدمه أداتا record_audio وspeech_to_text.</string>
  <string name="perm_label_phone_state">حالة الهاتف</string>
  <string name="perm_desc_phone_state">تستخدمه أداة get_telephony_info (مشغل SIM والإشارة).</string>
  <string name="perm_label_fine_location">الموقع الدقيق</string>
  <string name="perm_desc_fine_location">تستخدمه أداتا get_location وget_wifi_info.</string>
  <string name="perm_label_coarse_location">الموقع التقريبي</string>
  <string name="perm_desc_coarse_location">موقع تقريبي بديل لأداة get_location.</string>
  <string name="perm_label_contacts">جهات الاتصال</string>
  <string name="perm_desc_contacts">تستخدمه أداتا search_contacts وlist_contacts.</string>
  <string name="perm_label_call_log">سجل المكالمات</string>
  <string name="perm_desc_call_log">تستخدمه أداة list_call_log.</string>
  <string name="perm_label_sms">الرسائل النصية</string>
  <string name="perm_desc_sms">تستخدمه أداتا list_sms_inbox وsearch_sms.</string>
  <string name="perm_label_send_sms">إرسال رسائل SMS</string>
  <string name="perm_desc_send_sms">تستخدمه أداة send_sms لإرسال الرسائل النصية برمجيًا.</string>
  <string name="perm_label_termux_run">Termux RUN_COMMAND</string>
  <string name="perm_desc_termux_run">يتيح لـ ZeroAgent تشغيل الأوامر داخل Termux لأداة termux_run_command.</string>
  <string name="perm_desc_runtime_default">إذن وقت تشغيل تتطلبه أداة واحدة أو أكثر من الأدوات الممكّنة.</string>
