<resources>
    <string name="setting_floating_ball_page_title">懸浮球</string>
    <string name="setting_floating_ball_enable_title">顯示懸浮球</string>
    <string name="setting_floating_ball_enable_desc">在其他 App 上方顯示小圓球。點一下開啟快速聊天，長按開始語音對話。</string>
    <string name="setting_floating_ball_overlay_title">顯示在其他 App 上方</string>
    <string name="setting_floating_ball_overlay_granted">已授權</string>
    <string name="setting_floating_ball_overlay_required">需要這項權限才能顯示懸浮球</string>
    <string name="setting_floating_ball_overlay_grant">前往授權</string>
    <string name="setting_floating_ball_gestures_title">操作手勢</string>
    <string name="setting_floating_ball_gestures_desc">點一下：快速聊天；長按：開始語音對話；拖曳：移動位置，放開後自動靠邊。</string>
    <string name="setting_floating_ball_voice_title">語音對話</string>
    <string name="setting_floating_ball_asr_hint">請在「語音服務 → 語音對話」設定供應商與模型。長按懸浮球即可開啟原生即時語音對話。</string>
    <string name="setting_floating_ball_screen_action_hint">快速聊天面板中的「Agent 接手」可讓智慧體讀取並操作目前畫面；開始操作後，面板會自動收起。</string>
    <string name="setting_floating_ball_notes">開啟懸浮球時，通知列會保留一則低優先順序通知。在此關閉懸浮球，也會一併停止服務並移除通知。</string>
    <string name="setting_floating_ball_idle_title">閒置時自動靠邊隱藏</string>
    <string name="setting_floating_ball_idle_desc">超過設定時間未操作時，懸浮球會滑入螢幕邊緣，露出一半並降低不透明度。隱藏後仍可拖曳；點一下先喚出，再點一下開啟面板。</string>
    <string name="setting_floating_ball_idle_off">關閉</string>
    <string name="setting_floating_ball_idle_seconds">%d 秒</string>
    <string name="setting_floating_ball_alpha_title">隱藏時的不透明度</string>
    <string name="setting_floating_ball_alpha_desc">調整懸浮球靠邊隱藏時的透明程度。</string>
    <string name="setting_floating_ball_icon_title">懸浮球圖示</string>
    <string name="setting_floating_ball_icon_desc">使用內建圖示，或選擇圖片作為懸浮球外觀；圖片會裁切成圓形。</string>
    <string name="setting_floating_ball_icon_pick">選擇圖片</string>
    <string name="setting_floating_ball_icon_reset">還原預設圖示</string>
    <string name="setting_floating_ball_color_title">懸浮球顏色</string>
    <string name="setting_floating_ball_color_follow_theme">跟隨 App 主題</string>
    <string name="setting_floating_ball_color_custom">自訂顏色</string>
    <string name="setting_floating_ball_change">變更</string>
    <string name="setting_page_accessibility_status_enabled_not_connected">服務：已啟用，尚未連線</string>
    <string name="setting_page_accessibility_status_enabled_help">系統已啟用這項服務，但尚未連上 ZeroAgent，可能發生在程式剛重新啟動時。稍候查看狀態，或到系統設定將服務關閉後再開啟。</string>
    <string name="setting_page_accessibility_repair">一鍵修復（Shizuku）</string>
    <string name="setting_page_accessibility_repair_desc">若系統自行關閉服務，可使用 ZeroAgent 已取得的 Shizuku 權限重新啟用，不必再次切換系統開關。</string>
    <string name="setting_page_accessibility_repair_ok_toast">已重新啟用無障礙服務。</string>
    <string name="setting_page_accessibility_repair_fail_toast">修復失敗：%1$s</string>
    <string name="setting_page_accessibility_repair_shizuku_not_installed">需要 Shizuku：尚未安裝 Shizuku App。</string>
    <string name="setting_page_accessibility_repair_shizuku_not_running">需要 Shizuku：Shizuku 服務尚未啟動。</string>
    <string name="setting_page_accessibility_restricted_title">開關無法使用？允許受限制的設定</string>
    <string name="setting_page_accessibility_restricted_help">Android 13 以上可能限制從應用程式商店以外安裝的 App。請開啟 ZeroAgent 的「應用程式資訊」→ 右上角 ⋮ →「允許受限制的設定」，再返回開啟服務。若未看到這個選項，可先點一下停用的服務開關，查看系統提示。</string>
    <string name="setting_page_accessibility_open_app_info">開啟應用程式資訊</string>
    <string name="setting_page_accessibility_keepalive_section">背景執行</string>
    <string name="setting_page_accessibility_keepalive_title_generic">服務被系統關閉？允許背景執行</string>
    <string name="setting_page_accessibility_keepalive_body_generic">部分系統會清理背景 App，連帶中斷無障礙服務，即使系統開關仍顯示開啟，工具也可能回報服務未啟動。請允許 ZeroAgent 自動啟動與背景電池使用，並視需要在最近使用的 App 中鎖定。</string>
    <string name="setting_page_accessibility_keepalive_title_vivo">vivo／OriginOS：避免服務被關閉</string>
    <string name="setting_page_accessibility_keepalive_body_vivo">OriginOS 的省電機制可能中斷服務。請依序確認：① 設定 → 應用程式與權限 → 權限管理 → ZeroAgent → 自動啟動；② 設定 → 電池 → 背景耗電管理 → ZeroAgent → 允許背景高耗電；③ 在最近使用的 App 畫面將 ZeroAgent 卡片鎖定。</string>
    <string name="setting_page_accessibility_keepalive_title_xiaomi">小米／HyperOS：避免服務被關閉</string>
    <string name="setting_page_accessibility_keepalive_body_xiaomi">HyperOS 的省電機制可能中斷服務。請依序確認：① 設定 → 應用程式管理 → ZeroAgent → 省電設定 → 無限制；② 開啟 ZeroAgent 的自動啟動；③ 在最近使用的 App 畫面將 ZeroAgent 卡片鎖定。</string>
    <string name="setting_page_accessibility_keepalive_title_huawei">華為／HarmonyOS：避免服務被關閉</string>
    <string name="setting_page_accessibility_keepalive_body_huawei">HarmonyOS 的省電機制可能中斷服務。請依序確認：① 設定 → 應用程式 → 啟動管理 → ZeroAgent → 關閉自動管理，手動允許自動啟動、關聯啟動與背景活動；② 設定 → 電池 → 更多電池設定 → 允許 ZeroAgent 持續執行；③ 在最近使用的 App 畫面鎖定 ZeroAgent。</string>
    <string name="setting_page_accessibility_keepalive_title_oppo">OPPO／ColorOS：避免服務被關閉</string>
    <string name="setting_page_accessibility_keepalive_body_oppo">ColorOS 的省電機制可能中斷服務。請依序確認：① 設定 → 應用程式管理 → ZeroAgent → 電池使用 → 允許背景活動；② 允許自動啟動及關聯啟動；③ 在最近使用的 App 卡片選單點選「鎖定」。</string>
    <string name="setting_page_accessibility_keepalive_battery_ok">電池最佳化：已允許不受限制</string>
    <string name="setting_page_accessibility_keepalive_battery_needed">電池最佳化：仍受限制，點一下調整</string>
