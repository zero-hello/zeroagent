    <string name="memory12_accept">啟用並下載</string>
    <string name="memory12_cancel">取消</string>
    <string name="memory12_erase_hint">將清除情境記憶與情緒狀態，並停止收集。原有手動記憶與對話紀錄會保留。</string>
    <string name="memory12_record">記憶片段</string>
    <string name="memory12_close">關閉</string>
    <string name="memory12_delete">刪除此片段</string>
