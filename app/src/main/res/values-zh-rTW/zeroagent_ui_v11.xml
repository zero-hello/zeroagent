<?xml version="1.0" encoding="utf-8"?>
<resources>
  <string name="getting_started_title">快速上手</string>
  <string name="getting_started_intro_title">開始聊天之前</string>
  <string name="getting_started_intro_desc">App 安裝後預設什麼都沒有：沒有模型、工具全部關閉、權限也未授予。完成下面四件事，它才會變成你安裝時期待的那個 Agent。</string>
  <string name="getting_started_progress">已完成 %1$d/%2$d</string>
  <string name="getting_started_step_model_title">新增模型</string>
  <string name="getting_started_step_model_desc">進入「提供商」頁面擇一填入 API 金鑰（OpenRouter，或任何 OpenAI 相容端點）。沒有模型，對話就無法回覆。</string>
  <string name="getting_started_step_tools_title">開啟工具</string>
  <string name="getting_started_step_tools_desc">工具預設全部關閉，不開就只是一個普通聊天 App。勾選你想讓助手使用的工具分組。</string>
  <string name="getting_started_step_permissions_title">授予權限</string>
  <string name="getting_started_step_permissions_desc">無障礙讓 Agent 能看見並點選螢幕；通知存取讓它讀取通知。其餘權限等工具實際用到時再給。</string>
  <string name="getting_started_step_workspace_title">綁定工作區</string>
  <string name="getting_started_step_workspace_desc">工作區提供 Agent 存放檔案與冷記憶的位置。可選，但所有與檔案相關的功能都需要它。</string>
  <string name="getting_started_go">前往設定</string>
  <string name="getting_started_done">已完成</string>
  <string name="getting_started_finish">開始使用</string>
  <string name="getting_started_later">稍後再說</string>
  <string name="getting_started_keepalive_title">別讓系統把它清掉</string>
  <string name="getting_started_keepalive_desc">部分系統（Vivo／小米／華為）會在背景清理應用程式，無障礙服務開啟後仍可能被系統收回，螢幕工具就會跟著失效。請先到「無障礙」設定完成一次背景保留設定。</string>
  <string name="getting_started_keepalive_open">前往設定</string>
  <string name="perm_label_overlay">顯示在其他應用程式上層</string>
  <string name="perm_desc_overlay">允許 ZeroAgent 在自動化進行時顯示「Agent 正在工作」的懸浮視窗。</string>
  <string name="perm_label_write_settings">修改系統設定</string>
  <string name="perm_desc_write_settings">允許 Agent 透過 set_brightness 調整螢幕亮度。</string>
  <string name="perm_label_dnd">勿擾模式存取權</string>
  <string name="perm_desc_dnd">允許 Agent 變更鈴聲模式與各音訊串流的音量。</string>
  <string name="perm_label_battery">忽略電池最佳化</string>
  <string name="perm_desc_battery">協助背景任務在螢幕關閉時持續執行。</string>
  <string name="perm_label_post_notifications">傳送通知</string>
  <string name="perm_desc_post_notifications">顯示語音、任務進度與背景服務通知。</string>
  <string name="perm_desc_custom">自訂權限。所屬應用程式可能尚未安裝。</string>
  <string name="perm_desc_auto">安裝時自動授予（無需使用者操作）。</string>
  <string name="perm_label_accessibility">螢幕自動化（無障礙）</string>
  <string name="perm_desc_accessibility">點選、滑動、click_node、截圖、read_window_tree、set_text 等操作介面的工具需要此權限。</string>
  <string name="perm_label_notification_listener">通知存取</string>
  <string name="perm_desc_notification_listener">允許助理讀取你授權的 App 通知。</string>
  <string name="perm_label_camera">相機</string>
  <string name="perm_desc_camera">take_photo 工具用來拍攝靜態影像。</string>
  <string name="perm_label_microphone">麥克風</string>
  <string name="perm_desc_microphone">record_audio 與 speech_to_text 工具使用。</string>
  <string name="perm_label_phone_state">手機狀態</string>
  <string name="perm_desc_phone_state">get_telephony_info 工具使用（SIM 電信業者、訊號）。</string>
  <string name="perm_label_fine_location">精確位置</string>
  <string name="perm_desc_fine_location">get_location 與 get_wifi_info 工具使用。</string>
  <string name="perm_label_coarse_location">約略位置</string>
  <string name="perm_desc_coarse_location">get_location 的約略位置備援。</string>
  <string name="perm_label_contacts">聯絡人</string>
  <string name="perm_desc_contacts">search_contacts 與 list_contacts 工具使用。</string>
  <string name="perm_label_call_log">通話記錄</string>
  <string name="perm_desc_call_log">list_call_log 工具使用。</string>
  <string name="perm_label_sms">簡訊</string>
  <string name="perm_desc_sms">list_sms_inbox 與 search_sms 工具使用。</string>
  <string name="perm_label_send_sms">傳送簡訊</string>
  <string name="perm_desc_send_sms">send_sms 工具用來以程式方式傳送簡訊。</string>
  <string name="perm_label_termux_run">Termux RUN_COMMAND</string>
  <string name="perm_desc_termux_run">允許 ZeroAgent 在 Termux 中啟動指令，供 termux_run_command 工具使用。</string>
  <string name="perm_desc_runtime_default">一個或多個已啟用的工具所需的執行階段權限。</string>
    <string name="zeroagent_permission_background_location">背景位置</string>
    <string name="zeroagent_permission_background_location_hint">前往應用程式設定的「權限 → 位置」，選擇「一律允許」（若系統提供）。請先允許使用 App 時存取位置。</string>
    <string name="zeroagent_permission_all_files">所有檔案存取權</string>
    <string name="zeroagent_permission_all_files_hint">允許你選用的檔案工具存取共用檔案。</string>
    <string name="zeroagent_permission_usage">使用情況存取權</string>
    <string name="zeroagent_permission_usage_hint">允許助理查看目前使用的 App。</string>
    <string name="zeroagent_permission_other">其他應用程式權限</string>
    <string name="zeroagent_permission_keyboard">鍵盤整合</string>
    <string name="zeroagent_permission_shizuku">Shizuku 存取權</string>
    <string name="zeroagent_permission_open_failed">無法開啟系統設定，請從手機設定開啟 ZeroAgent 的應用程式資訊。</string>
    <string name="zeroagent_drawer_chats">對話</string>
    <string name="zeroagent_drawer_tasks">任務</string>
    <string name="zeroagent_theme_unnamed">未命名主題</string>
    <string name="zeroagent_permission_unavailable">無法授予</string>
    <string name="zeroagent_permission_restricted">這項存取權由 Android 或所屬 App 管理，無法在此授予。</string>
</resources>
