<?xml version="1.0" encoding="utf-8"?>
<resources>
  <string name="getting_started_title">はじめに</string>
  <string name="getting_started_intro_title">最初のチャットの前に</string>
  <string name="getting_started_intro_desc">アプリは何も設定されていない状態で届きます。モデルなし、ツールはすべてオフ、権限も未付与です。次の 4 つを済ませれば、インストールした目的どおりのエージェントになります。</string>
  <string name="getting_started_progress">完了 %1$d/%2$d</string>
  <string name="getting_started_step_model_title">モデルを追加</string>
  <string name="getting_started_step_model_desc">「プロバイダー」を開き、API キーを貼り付けます（OpenRouter、または OpenAI 互換の任意のエンドポイント）。モデルがないとチャットは返信できません。</string>
  <string name="getting_started_step_tools_title">ツールをオンにする</string>
  <string name="getting_started_step_tools_desc">ツールは既定ですべてオフのため、そのままでは普通のチャットアプリと同じです。アシスタントに使わせたいグループを選んでください。</string>
  <string name="getting_started_step_permissions_title">権限を付与</string>
  <string name="getting_started_step_permissions_desc">ユーザー補助をオンにするとエージェントが画面を見てタップできます。通知アクセスをオンにすると通知を読めます。その他の権限は、ツールが実際に必要になったときに付与すれば十分です。</string>
  <string name="getting_started_step_workspace_title">ワークスペースを紐付け</string>
  <string name="getting_started_step_workspace_desc">ワークスペースはエージェントにファイルとコールドメモリの置き場所を与えます。任意ですが、ファイル関連の機能には必要です。</string>
  <string name="getting_started_go">開く</string>
  <string name="getting_started_done">完了</string>
  <string name="getting_started_finish">使い始める</string>
  <string name="getting_started_later">あとで</string>
  <string name="getting_started_keepalive_title">システムに停止されないようにする</string>
  <string name="getting_started_keepalive_desc">一部のシステム（Vivo/Xiaomi/Huawei）では、バックグラウンド整理によりユーザー補助サービスを有効にしてもしばらくしてシステムに無効化され、画面ツールが動かなくなります。「ユーザー補助」設定でバックグラウンド維持の設定を一度済ませてください。</string>
  <string name="getting_started_keepalive_open">開く</string>
  <string name="perm_label_overlay">他のアプリの上に重ねて表示</string>
  <string name="perm_desc_overlay">自動化の実行中に、ZeroAgent が「エージェントが動作中」のオーバーレイを表示できるようにします。</string>
  <string name="perm_label_write_settings">システム設定の変更</string>
  <string name="perm_desc_write_settings">エージェントが set_brightness で画面の明るさを変更できるようにします。</string>
  <string name="perm_label_dnd">サイレントモードへのアクセス</string>
  <string name="perm_desc_dnd">エージェントが着信音モードと各ストリームの音量を変更できるようにします。</string>
  <string name="perm_label_battery">電池の最適化を無視</string>
  <string name="perm_desc_battery">画面消灯中もバックグラウンドのタスクを継続しやすくします。</string>
  <string name="perm_label_post_notifications">通知の送信</string>
  <string name="perm_desc_post_notifications">音声、タスクの進行状況、バックグラウンドサービスの通知を表示します。</string>
  <string name="perm_desc_custom">カスタム権限です。所有アプリがまだインストールされていない可能性があります。</string>
  <string name="perm_desc_auto">インストール時に自動付与されます（ユーザー操作は不要）。</string>
  <string name="perm_label_accessibility">画面自動化（ユーザー補助）</string>
  <string name="perm_desc_accessibility">tap、swipe、click_node、screenshot、read_window_tree、set_text など画面を操作するツールに必要です。</string>
  <string name="perm_label_notification_listener">通知アクセス</string>
  <string name="perm_desc_notification_listener">許可したアプリの通知をエージェントが読めるようにします。</string>
  <string name="perm_label_camera">カメラ</string>
  <string name="perm_desc_camera">take_photo が静止画を撮影するために使用します。</string>
  <string name="perm_label_microphone">マイク</string>
  <string name="perm_desc_microphone">record_audio と speech_to_text が使用します。</string>
  <string name="perm_label_phone_state">電話の状態</string>
  <string name="perm_desc_phone_state">get_telephony_info（SIM 事業者、電波状態）が使用します。</string>
  <string name="perm_label_fine_location">正確な位置情報</string>
  <string name="perm_desc_fine_location">get_location と get_wifi_info が使用します。</string>
  <string name="perm_label_coarse_location">おおよその位置情報</string>
  <string name="perm_desc_coarse_location">get_location のフォールバックとして使うおおよその位置情報です。</string>
  <string name="perm_label_contacts">連絡先</string>
  <string name="perm_desc_contacts">search_contacts と list_contacts が使用します。</string>
  <string name="perm_label_call_log">通話履歴</string>
  <string name="perm_desc_call_log">list_call_log が使用します。</string>
  <string name="perm_label_sms">SMS</string>
  <string name="perm_desc_sms">list_sms_inbox と search_sms が使用します。</string>
  <string name="perm_label_send_sms">SMS の送信</string>
  <string name="perm_desc_send_sms">send_sms がプログラムからテキストメッセージを送信するために使用します。</string>
  <string name="perm_label_termux_run">Termux RUN_COMMAND</string>
  <string name="perm_desc_termux_run">termux_run_command ツールのために、ZeroAgent が Termux 内でコマンドを起動できるようにします。</string>
  <string name="perm_desc_runtime_default">有効ないずれかのツールが必要とする実行時権限です。</string>
