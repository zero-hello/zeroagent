<resources>
    <string name="za6s_root_title">Root access</string>
    <string name="za6s_root_heading">Superuser access</string>
    <string name="za6s_root_intro">Root lets the agent read or change protected phone files. It needs a rooted phone and your superuser manager’s approval. ZeroAgent does not root your phone.</string>
    <string name="za6s_root_allow">Allow root tools</string>
    <string name="za6s_root_enabled">Enabled. Access is checked again for each command.</string>
    <string name="za6s_root_off">Off. No superuser command can run.</string>
    <string name="za6s_root_disabled">Off. ZeroAgent stopped its root shell. Earlier changes remain.</string>
    <string name="za6s_root_granted">Superuser access granted. Every command still asks for your approval.</string>
    <string name="za6s_root_denied">Not granted. Check your superuser manager and try again.</string>
    <string name="za6s_root_error">Could not check root access. Try again.</string>
    <string name="za6s_root_approval">You see and approve the exact command before it runs. Automatic approval and background tasks cannot bypass this check.</string>
    <string name="za6s_root_revoke">Turning this off blocks new commands and stops ZeroAgent’s current root shell. Child processes started by your command may need to be stopped separately. To revoke Android’s stored superuser grant too, open your superuser manager and revoke ZeroAgent.</string>
    <string name="za6s_root_not_undo">Changes made by an approved command are not undone when access is turned off.</string>
