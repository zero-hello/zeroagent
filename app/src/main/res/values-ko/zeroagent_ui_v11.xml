<?xml version="1.0" encoding="utf-8"?>
<resources>
  <string name="getting_started_title">시작하기</string>
  <string name="getting_started_intro_title">첫 대화를 시작하기 전에</string>
  <string name="getting_started_intro_desc">앱은 아무것도 설정되지 않은 상태로 설치됩니다. 모델 없음, 도구 모두 꺼짐, 권한 없음. 아래 네 가지만 마치면 설치한 목적에 맞는 에이전트가 됩니다.</string>
  <string name="getting_started_progress">완료 %1$d/%2$d</string>
  <string name="getting_started_step_model_title">모델 추가</string>
  <string name="getting_started_step_model_desc">제공업체 화면을 열고 API 키를 붙여넣으세요(OpenRouter 또는 OpenAI 호환 엔드포인트). 모델이 없으면 대화에 답할 수 없습니다.</string>
  <string name="getting_started_step_tools_title">도구 켜기</string>
  <string name="getting_started_step_tools_desc">도구는 기본적으로 모두 꺼져 있어 그대로 두면 일반 채팅 앱과 같습니다. 어시스턴트가 사용할 그룹을 선택하세요.</string>
  <string name="getting_started_step_permissions_title">권한 부여</string>
  <string name="getting_started_step_permissions_desc">접근성을 켜면 에이전트가 화면을 보고 탭할 수 있고, 알림 접근을 켜면 알림을 읽을 수 있습니다. 나머지 권한은 도구가 실제로 필요할 때 부여하면 됩니다.</string>
  <string name="getting_started_step_workspace_title">작업 공간 연결</string>
  <string name="getting_started_step_workspace_desc">작업 공간은 에이전트에 파일과 콜드 메모리를 둘 공간을 제공합니다. 선택 사항이지만 파일 관련 기능에는 필요합니다.</string>
  <string name="getting_started_go">열기</string>
  <string name="getting_started_done">완료</string>
  <string name="getting_started_finish">사용 시작</string>
  <string name="getting_started_later">나중에</string>
  <string name="getting_started_keepalive_title">시스템이 정리하지 못하게 하기</string>
  <string name="getting_started_keepalive_desc">일부 시스템(Vivo/Xiaomi/Huawei)에서는 백그라운드 정리로 인해 접근성 서비스를 켠 뒤에도 잠시 후 시스템이 서비스를 해제해 화면 도구가 작동하지 않습니다. 접근성 설정에서 백그라운드 유지 설정을 한 번 완료하세요.</string>
  <string name="getting_started_keepalive_open">열기</string>
  <string name="perm_label_overlay">다른 앱 위에 표시</string>
  <string name="perm_desc_overlay">자동화가 진행되는 동안 ZeroAgent가 에이전트 작업 중 오버레이를 표시할 수 있도록 합니다.</string>
  <string name="perm_label_write_settings">시스템 설정 변경</string>
  <string name="perm_desc_write_settings">에이전트가 set_brightness로 화면 밝기를 변경할 수 있도록 합니다.</string>
  <string name="perm_label_dnd">방해 금지 모드 접근</string>
  <string name="perm_desc_dnd">에이전트가 벨소리 모드와 스트림별 볼륨을 변경할 수 있도록 합니다.</string>
  <string name="perm_label_battery">배터리 최적화 무시</string>
  <string name="perm_desc_battery">화면이 꺼져 있어도 백그라운드 작업이 계속되도록 돕습니다.</string>
  <string name="perm_label_post_notifications">알림 보내기</string>
  <string name="perm_desc_post_notifications">음성, 작업 진행 상황 및 백그라운드 서비스 알림을 표시합니다.</string>
  <string name="perm_desc_custom">사용자 지정 권한입니다. 소유 앱이 아직 설치되지 않았을 수 있습니다.</string>
  <string name="perm_desc_auto">설치 시 자동으로 부여됩니다(사용자 작업 불필요).</string>
  <string name="perm_label_accessibility">화면 자동화(접근성)</string>
  <string name="perm_desc_accessibility">tap, swipe, click_node, screenshot, read_window_tree, set_text 등 화면을 조작하는 도구에 필요합니다.</string>
  <string name="perm_label_notification_listener">알림 접근</string>
  <string name="perm_desc_notification_listener">허용한 앱의 알림을 에이전트가 읽도록 허용합니다.</string>
  <string name="perm_label_camera">카메라</string>
  <string name="perm_desc_camera">take_photo가 정지 이미지를 촬영할 때 사용합니다.</string>
  <string name="perm_label_microphone">마이크</string>
  <string name="perm_desc_microphone">record_audio와 speech_to_text가 사용합니다.</string>
  <string name="perm_label_phone_state">휴대전화 상태</string>
  <string name="perm_desc_phone_state">get_telephony_info(SIM 통신사, 신호)가 사용합니다.</string>
  <string name="perm_label_fine_location">정확한 위치</string>
  <string name="perm_desc_fine_location">get_location과 get_wifi_info가 사용합니다.</string>
  <string name="perm_label_coarse_location">대략적인 위치</string>
  <string name="perm_desc_coarse_location">get_location의 대략적인 위치 대체값입니다.</string>
  <string name="perm_label_contacts">연락처</string>
  <string name="perm_desc_contacts">search_contacts와 list_contacts가 사용합니다.</string>
  <string name="perm_label_call_log">통화 기록</string>
  <string name="perm_desc_call_log">list_call_log가 사용합니다.</string>
  <string name="perm_label_sms">SMS</string>
  <string name="perm_desc_sms">list_sms_inbox와 search_sms가 사용합니다.</string>
  <string name="perm_label_send_sms">SMS 보내기</string>
  <string name="perm_desc_send_sms">send_sms가 프로그래밍 방식으로 문자 메시지를 보낼 때 사용합니다.</string>
  <string name="perm_label_termux_run">Termux RUN_COMMAND</string>
  <string name="perm_desc_termux_run">termux_run_command 도구를 위해 ZeroAgent가 Termux 안에서 명령을 실행할 수 있도록 합니다.</string>
  <string name="perm_desc_runtime_default">활성화된 하나 이상의 도구에 필요한 런타임 권한입니다.</string>
